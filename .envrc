# direnv configuration for llm-memory-bench (placeholder).
# Install direnv (https://direnv.net), then run `direnv allow` in this directory.

# Activate the uv-managed virtualenv if it exists (run `just sync` to create it).
if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$PWD/.venv/bin"
fi

# Load local secrets from .env (gitignored). Copy .env.example to .env and fill in.
dotenv_if_exists .env

# Required for `lmb run` — set in .env or uncomment and replace below:
# export NVIDIA_API_KEY="nvapi-REPLACE_ME"
